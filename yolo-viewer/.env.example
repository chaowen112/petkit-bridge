# Private local settings. Keep this file mode 0600; never commit it.
GO2RTC_API_URL=
GO2RTC_RTSP_BASE_URL=
GO2RTC_API_USERNAME=
GO2RTC_API_PASSWORD=
# Optional if multiple PetKit cameras are registered.
YOLO_STREAM_NAME=
# Optional override; otherwise constructed from the authenticated RTSP base.
YOLO_RTSP_URL=
# If blank, viewer link token is generated for this run.
YOLO_VIEWER_TOKEN=
YOLO_MODEL=yolo11n.pt
YOLO_INFERENCE_FPS=2
# Set both to the Mac LAN IP for phone access.
YOLO_VIEWER_HOST=127.0.0.1
YOLO_VIEWER_LINK_HOST=localhost
# Optional: annotated cat snapshots sent via the configured Hermes Telegram sender.
# Format: telegram:<chat_id>[:<thread_id>]. Keep the real target in private .env.
YOLO_CAT_ALERT_TARGET=
YOLO_CAT_ALERT_MIN_CONFIDENCE=0.6
YOLO_CAT_ALERT_COOLDOWN_SECONDS=60
